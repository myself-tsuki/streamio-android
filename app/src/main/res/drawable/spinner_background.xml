<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_surfaceContainerHighest" />
                    <stroke android:width="1.5dp" android:color="@color/md_theme_primary" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_surfaceContainerHighest" />
                    <stroke android:width="1.5dp" android:color="@color/md_theme_primary" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_surfaceContainerHigh" />
                    <stroke android:width="1dp" android:color="@color/md_theme_outlineVariant" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item
        android:drawable="@drawable/ic_arrow_down"
        android:gravity="end|center_vertical"
        android:right="14dp" />
</layer-list> 