<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="48dp">

            <!-- Top Studio Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <!-- Logo & Title -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/app_logo_round"
                        android:contentDescription="@string/app_name" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stream Prime"
                            android:textAppearance="@style/TextAppearance.App.TitleLarge"
                            android:textColor="@color/md_theme_onSurface"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STUDIO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="@color/md_theme_onPrimaryContainer"
                            android:background="@drawable/prism_overlay_background"
                            android:backgroundTint="@color/md_theme_primaryContainer"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Professional Live Broadcast Engine"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/md_theme_onSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

            <!-- Hero Live Stream Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_start_stream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/md_theme_primary"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Status Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/prism_overlay_background"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="14dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/live_status_indicator"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="READY TO STREAM"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            android:textColor="@color/md_theme_primary" />

                    </LinearLayout>

                    <!-- Headline & Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Screen Stream"
                        android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
                        android:textColor="@color/md_theme_onSurface"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Broadcast screen capture, games, or camera with full hardware audio mixer and customizable stream overlays."
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Action Bar Inside Hero Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Start Broadcast"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_screen"
                            app:iconPadding="8dp"
                            app:iconTint="@color/md_theme_onPrimary"
                            app:backgroundTint="@color/md_theme_primary"
                            android:textColor="@color/md_theme_onPrimary"
                            android:clickable="false"
                            android:focusable="false" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/md_theme_primary"
                            android:contentDescription="Launch" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Studio Tools"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="@color/md_theme_primary"
                android:letterSpacing="0.05"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp" />

            <!-- File Streaming Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_file_streaming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardBackgroundColor="@color/md_theme_surfaceContainer"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/md_theme_secondaryContainer">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_file"
                            android:scaleType="centerInside"
                            android:padding="12dp"
                            app:tint="@color/md_theme_onSecondaryContainer"
                            android:contentDescription="File Streaming" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="File Streaming"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textColor="@color/md_theme_onSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Broadcast pre-recorded video files in loop"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/md_theme_onSurfaceVariant"
                        android:contentDescription="Open File Streaming" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Stream Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardBackgroundColor="@color/md_theme_surfaceContainer"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/md_theme_tertiaryContainer">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_settings"
                            android:scaleType="centerInside"
                            android:padding="12dp"
                            app:tint="@color/md_theme_onTertiaryContainer"
                            android:contentDescription="Settings" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stream Settings"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textColor="@color/md_theme_onSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolution, bitrate, audio sync &amp; RTMP keys"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/md_theme_onSurfaceVariant"
                        android:contentDescription="Open Settings" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Version Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/main_version_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/version"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="@color/md_theme_outline"
                    android:background="@drawable/prism_overlay_background"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
