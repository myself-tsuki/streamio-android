<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar / Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical"
            android:background="@color/md_theme_surface"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="Back">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/md_theme_onSurface" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stream Settings"
                android:textAppearance="@style/TextAppearance.App.TitleLarge"
                android:textColor="@color/md_theme_onSurface"
                android:textStyle="bold"
                android:gravity="center" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardBackgroundColor="@color/md_theme_primaryContainer"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="Save">

                <ImageView
                    android:id="@+id/btn_save"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    app:tint="@color/md_theme_onPrimaryContainer" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Settings Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Streaming Mode Section -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="12dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/md_theme_primaryContainer">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_screen"
                                    app:tint="@color/md_theme_onPrimaryContainer" />

                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Streaming Mode"
                                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                    android:textColor="@color/md_theme_onSurface"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Select broadcast orientation"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="@color/md_theme_onSurfaceVariant" />

                            </LinearLayout>

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/md_theme_outlineVariant"
                            app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh">

                            <Spinner
                                android:id="@+id/spinner_streaming_mode"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/spinner_background"
                                android:popupBackground="@color/md_theme_surfaceContainerHigh"
                                android:spinnerMode="dropdown"
                                android:dropDownWidth="match_parent" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- RTMP Configuration Section -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="12dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/md_theme_secondaryContainer">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_stream_start"
                                    app:tint="@color/md_theme_onSecondaryContainer" />

                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="RTMP Configuration"
                                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                    android:textColor="@color/md_theme_onSurface"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Platform destination and keys"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="@color/md_theme_onSurfaceVariant" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Streaming Service -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streaming Service"
                            android:textAppearance="@style/TextAppearance.App.LabelMedium"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/md_theme_outlineVariant"
                            app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh">

                            <Spinner
                                android:id="@+id/spinner_streaming_service"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/spinner_background"
                                android:popupBackground="@color/md_theme_surfaceContainerHigh"
                                android:spinnerMode="dropdown"
                                android:dropDownWidth="match_parent" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Stream URL (visible for custom rtmp) -->
                        <LinearLayout
                            android:id="@+id/til_stream_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="14dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Stream Server URL"
                                app:boxStrokeColor="@color/md_theme_primary"
                                style="@style/Widget.App.TextInputLayout">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_stream_url"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textUri"
                                    android:textColor="@color/md_theme_onSurface" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <!-- Stream Key -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Stream Key"
                            app:boxStrokeColor="@color/md_theme_primary"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/md_theme_onSurfaceVariant"
                            style="@style/Widget.App.TextInputLayout">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_stream_key"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textColor="@color/md_theme_onSurface" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Voice Chat Compatibility -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_voice_chat_compatibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/game_voice_chat_compatibility_title"
                                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                    android:textColor="@color/md_theme_onSurface"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/game_voice_chat_compatibility_summary"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="@color/md_theme_onSurfaceVariant" />

                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switch_voice_chat_compatibility"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:contentDescription="@string/game_voice_chat_compatibility_title" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_voice_chat_compatibility_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/game_voice_chat_compatibility_disabled"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/md_theme_outline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_accessibility_settings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/open_accessibility_settings"
                            style="@style/Widget.App.Button.Secondary"
                            android:visibility="gone" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Quality Settings Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_quality_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="12dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/md_theme_tertiaryContainer">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_settings"
                                    app:tint="@color/md_theme_onTertiaryContainer" />

                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Quality Settings"
                                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                    android:textColor="@color/md_theme_onSurface"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Resolution, FPS &amp; Bitrate"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="@color/md_theme_onSurfaceVariant" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Resolution -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolution"
                            android:textAppearance="@style/TextAppearance.App.LabelMedium"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/md_theme_outlineVariant"
                            app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh">

                            <Spinner
                                android:id="@+id/spinner_resolution"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/spinner_background"
                                android:popupBackground="@color/md_theme_surfaceContainerHigh"
                                android:spinnerMode="dropdown"
                                android:dropDownWidth="match_parent" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- FPS -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frame Rate (FPS)"
                            android:textAppearance="@style/TextAppearance.App.LabelMedium"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/md_theme_outlineVariant"
                            app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh">

                            <Spinner
                                android:id="@+id/spinner_fps"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/spinner_background"
                                android:popupBackground="@color/md_theme_surfaceContainerHigh"
                                android:spinnerMode="dropdown"
                                android:dropDownWidth="match_parent" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Bitrate -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Bitrate (kbps)"
                            app:helperText="Recommended: 2500 - 6000 kbps (10000 kbps = 10 Mbps)"
                            app:boxStrokeColor="@color/md_theme_primary"
                            style="@style/Widget.App.TextInputLayout">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_bitrate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/md_theme_onSurface" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Actions Dock -->
        <LinearLayout
            android:id="@+id/bottom_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:gravity="center"
            android:background="@color/md_theme_surfaceContainerLow"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="Reset Defaults"
                style="@style/Widget.App.Button.Secondary"
                android:textColor="@color/md_theme_error"
                app:strokeColor="@color/md_theme_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_settings"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Save Settings"
                style="@style/Widget.App.Button"
                app:backgroundTint="@color/md_theme_primary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 
