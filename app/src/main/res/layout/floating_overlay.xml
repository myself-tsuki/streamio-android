<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/md_theme_outlineVariant"
    app:cardBackgroundColor="@color/md_theme_surfaceContainerHighest">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <!-- Stream Start/Stop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_floating_stream"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_stream_start"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:padding="0dp"
            app:iconTint="@color/md_theme_onPrimary"
            app:backgroundTint="@color/md_theme_primary"
            android:layout_marginBottom="8dp"
            android:contentDescription="Stream" />

        <!-- Settings Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_floating_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_settings"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:padding="0dp"
            app:iconTint="@color/md_theme_onSurface"
            app:backgroundTint="@color/md_theme_surfaceContainerHigh"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            android:layout_marginBottom="8dp"
            android:contentDescription="Settings" />

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_floating_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_close"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:padding="0dp"
            app:iconTint="@color/md_theme_error"
            app:backgroundTint="@color/md_theme_surfaceContainerHigh"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            android:contentDescription="Close" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
 