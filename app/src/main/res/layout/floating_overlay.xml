<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/prism_overlay_background"
    android:elevation="8dp"
    android:gravity="center"
    android:padding="6dp">

    <!-- Stream Start/Stop Button -->
    <TextView
        android:id="@+id/btn_floating_stream"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="▶"
        android:textSize="18sp"
        android:textColor="@color/md_theme_onPrimary"
        android:gravity="center"
        android:background="@drawable/prism_stream_button"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="6dp"
        android:contentDescription="Stream" />

    <!-- Settings Button -->
    <TextView
        android:id="@+id/btn_floating_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="⚙"
        android:textSize="18sp"
        android:textColor="@color/md_theme_onSurface"
        android:gravity="center"
        android:background="@drawable/prism_circular_button"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="6dp"
        android:contentDescription="Settings" />

    <!-- Close Button -->
    <TextView
        android:id="@+id/btn_floating_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="✕"
        android:textSize="16sp"
        android:textColor="@color/md_theme_error"
        android:gravity="center"
        android:background="@drawable/prism_circular_button"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Close" />

</LinearLayout>
 