<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->
        <LinearLayout
            android:id="@+id/top_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="Back">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="?attr/colorOnSurface" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Title & Live Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stream Studio"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BROADCAST CONSOLE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <!-- Settings Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="Settings">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Video Preview Window -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_preview_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:layout_constraintTop_toBottomOf="@id/top_controls"
            app:layout_constraintBottom_toTopOf="@id/volume_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Video Surface -->
                <android.view.SurfaceView
                    android:id="@+id/surface_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/prism_video_placeholder" />

                <!-- Streaming Status Pill -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/streaming_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/live_status_indicator" />

                        <TextView
                            android:id="@+id/txt_live_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE"
                            android:textColor="?attr/colorError"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/txt_stream_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Bitrate Pill -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                    <TextView
                        android:id="@+id/txt_bitrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 Mbps"
                        android:textColor="?attr/colorPrimary"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall"
                        android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Overlay Editor Button (Official Material 3 auto_awesome icon) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_overlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="14dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:contentDescription="Overlay">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_auto_awesome"
                        app:tint="?attr/colorOnSurface" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Audio Volume Controls Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/volume_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:layout_constraintBottom_toTopOf="@id/bottom_controls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Audio Mixer"
                        android:textAppearance="@style/TextAppearance.App.LabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                </LinearLayout>

                <!-- Mic Volume -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_mic_on"
                        app:tint="?attr/colorPrimary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:text="Mic"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/seekbar_mic_volume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:splitTrack="false"
                        android:progressTint="?attr/colorPrimary"
                        android:thumbTint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/txt_mic_volume"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textAppearance="@style/TextAppearance.App.LabelMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:gravity="end" />

                </LinearLayout>

                <!-- Device Audio Volume (Official Material ic_screen_share icon) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_screen_share"
                        app:tint="?attr/colorSecondary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:text="Device"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/seekbar_device_volume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:splitTrack="false"
                        android:progressTint="?attr/colorSecondary"
                        android:thumbTint="?attr/colorSecondary" />

                    <TextView
                        android:id="@+id/txt_device_volume"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textAppearance="@style/TextAppearance.App.LabelMedium"
                        android:textColor="?attr/colorSecondary"
                        android:textStyle="bold"
                        android:gravity="end" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Action Controls Dock (With Safe Navigation Inset Padding) -->
        <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="42dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Mic Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mic"
                android:layout_width="64dp"
                android:layout_height="60dp"
                android:layout_marginEnd="16dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_mic_on"
                app:iconSize="22dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorPrimary"
                android:text="MIC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorSurfaceContainerHigh"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                android:contentDescription="Microphone" />

            <!-- Stream Start/Stop Hero Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stream"
                android:layout_width="144dp"
                android:layout_height="60dp"
                android:layout_marginEnd="16dp"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_stream_start"
                app:iconSize="24dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="?attr/colorOnPrimary"
                android:text="GO LIVE"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary"
                app:elevation="4dp"
                android:contentDescription="Stream" />

            <!-- Record Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_record"
                android:layout_width="64dp"
                android:layout_height="60dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_record"
                app:iconSize="22dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorError"
                android:text="REC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorError"
                app:backgroundTint="?attr/colorSurfaceContainerHigh"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                android:contentDescription="Record" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 