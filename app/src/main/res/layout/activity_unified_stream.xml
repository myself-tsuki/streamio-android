<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Control Bar -->
        <LinearLayout
            android:id="@+id/top_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <TextView
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="←"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface"
                android:gravity="center"
                android:background="@drawable/prism_circular_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back" />

            <!-- Title Header -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stream Studio"
                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                android:textColor="@color/md_theme_onSurface"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Settings Button -->
            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚙"
                android:textSize="20sp"
                android:textColor="@color/md_theme_onSurface"
                android:gravity="center"
                android:background="@drawable/prism_circular_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Settings" />

        </LinearLayout>

        <!-- Video Preview Window -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_preview_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:cardBackgroundColor="@color/md_theme_surfaceContainerLow"
            app:layout_constraintTop_toBottomOf="@id/top_controls"
            app:layout_constraintBottom_toTopOf="@id/volume_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Video Surface -->
                <android.view.SurfaceView
                    android:id="@+id/surface_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/prism_video_placeholder" />

                <!-- Streaming Overlay Status Pill -->
                <LinearLayout
                    android:id="@+id/streaming_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/prism_overlay_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/prism_live_indicator" />

                    <TextView
                        android:id="@+id/txt_live_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE"
                        android:textColor="@color/md_theme_error"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/txt_stream_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Bitrate Pill -->
                <TextView
                    android:id="@+id/txt_bitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:text="0.0 Mbps"
                    android:textColor="@color/md_theme_onSurface"
                    android:textAppearance="@style/TextAppearance.App.LabelMedium"
                    android:background="@drawable/prism_overlay_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />

                <!-- Overlay Editor Button -->
                <TextView
                    android:id="@+id/btn_overlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:text="🖼"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@color/md_theme_onSurface"
                    android:background="@drawable/prism_circular_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Overlay" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Audio Volume Controls Card -->
        <LinearLayout
            android:id="@+id/volume_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:background="@drawable/prism_overlay_background"
            android:padding="16dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_controls">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audio Mixer"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="@color/md_theme_primary"
                android:letterSpacing="0.04"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Mic Volume -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:text="🎤 Mic"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/md_theme_onSurface" />

                <SeekBar
                    android:id="@+id/seekbar_mic_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/md_theme_primary"
                    android:thumbTint="@color/md_theme_primary" />

                <TextView
                    android:id="@+id/txt_mic_volume"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textAppearance="@style/TextAppearance.App.LabelMedium"
                    android:textColor="@color/md_theme_primary"
                    android:gravity="end" />

            </LinearLayout>

            <!-- Device Audio Volume -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:text="📱 Device"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/md_theme_onSurface" />

                <SeekBar
                    android:id="@+id/seekbar_device_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/md_theme_secondary"
                    android:thumbTint="@color/md_theme_secondary" />

                <TextView
                    android:id="@+id/txt_device_volume"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textAppearance="@style/TextAppearance.App.LabelMedium"
                    android:textColor="@color/md_theme_secondary"
                    android:gravity="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Action Controls -->
        <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Mic Toggle Button -->
            <TextView
                android:id="@+id/btn_mic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="24dp"
                android:text="🎤"
                android:textSize="26sp"
                android:textColor="@color/md_theme_onSurface"
                android:gravity="center"
                android:background="@drawable/prism_circular_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Microphone" />

            <!-- Stream Start/Stop Hero Button -->
            <TextView
                android:id="@+id/btn_stream"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginEnd="24dp"
                android:text="▶"
                android:textSize="36sp"
                android:textColor="@color/md_theme_onPrimary"
                android:gravity="center"
                android:background="@drawable/prism_stream_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Stream" />

            <!-- Record Button -->
            <TextView
                android:id="@+id/btn_record"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="●"
                android:textSize="28sp"
                android:textColor="@color/md_theme_error"
                android:gravity="center"
                android:background="@drawable/prism_circular_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Record" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 