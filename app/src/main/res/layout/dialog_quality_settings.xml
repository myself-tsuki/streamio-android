<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/prism_overlay_background"
    android:padding="24dp">

    <!-- Dialog Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quality_settings"
        android:textColor="@color/md_theme_onSurface"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Resolution Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resolution"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="Select Resolution"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

        <AutoCompleteTextView
            android:id="@+id/resolution_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:text="720p (1280x720)"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- FPS Selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/frame_rate"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <TextView
            android:id="@+id/fps_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 FPS"
            android:textColor="@color/md_theme_primary"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/fps_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:value="30"
        android:stepSize="1"
        android:valueFrom="15"
        android:valueTo="60"
        app:thumbColor="@color/md_theme_primary"
        app:trackColorActive="@color/md_theme_primary"
        app:trackColorInactive="@color/md_theme_surfaceContainerHighest" />

    <!-- Bitrate Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bitrate_kbps"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Bitrate (kbps)"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_bitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2500"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_outline"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginEnd="8dp"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            app:cornerRadius="20dp"
            app:backgroundTint="@color/md_theme_primary"
            android:textColor="@color/md_theme_onPrimary" />

    </LinearLayout>

</LinearLayout> 